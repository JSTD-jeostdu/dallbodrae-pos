{
  "hosting": {
    "site": "dallbodrae-pos",
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      ".firebaserc",
      ".git/**",
      ".claude/**",
      ".superpowers/**",
      ".firebase/**",
      "**/.*",
      "**/.*/**",
      "**/*.md",
      "**/node_modules/**",
      "_preview*"
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/intro",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/intro.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/feedback",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "cleanUrls": true,
    "redirects": [
      {
        "source": "/안내",
        "destination": "/intro",
        "type": 301
      },
      {
        "source": "/guide",
        "destination": "/intro",
        "type": 301
      },
      {
        "source": "/평가",
        "destination": "/feedback",
        "type": 301
      },
      {
        "source": "/피드백",
        "destination": "/feedback",
        "type": 301
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
